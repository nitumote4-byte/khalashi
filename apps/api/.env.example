# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://khalashi:khalashi@localhost:5432/khalashi

# Auth / OTP
# mock = log OTP to console (dev). msg91 | 2factor for production SMS.
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
# Mock mode always accepts this code when set (optional convenience)
OTP_MOCK_CODE=123456

# JWT / session (Phase 1 shell — replace with real secret in prod)
SESSION_SECRET=change-me-in-production
SESSION_TTL_SECONDS=604800

# MSG91 (when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# 2Factor (when OTP_PROVIDER=2factor)
TWO_FACTOR_API_KEY=
