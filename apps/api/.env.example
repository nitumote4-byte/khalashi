# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://khalashi:khalashi@localhost:5432/khalashi

# ---------------------------------------------------------------------------
# Auth / OTP
# mock  = log OTP to console + return debugCode (DEFAULT for local / CI smoke)
# msg91 = real India SMS via MSG91 Send OTP API — only after DLT template approval
# 2factor = alternative stub (not fully wired yet)
# ---------------------------------------------------------------------------
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
# Mock mode always accepts this code when set (optional convenience)
OTP_MOCK_CODE=123456

# JWT / session — replace with a long random secret in production
SESSION_SECRET=change-me-in-production
SESSION_TTL_SECONDS=604800

# --- Production OTP (MSG91) ---
# NEVER put real keys in git. Leave blank here; set values only in:
#   • local .env (gitignored)
#   • Cursor Dashboard → Cloud Agents → Environments → Secrets
#   • GitHub → Settings → Secrets and variables → Actions (and/or Environments)
#
# Secret names (same names everywhere):
#   MSG91_AUTH_KEY
#   MSG91_TEMPLATE_ID
#   MSG91_SENDER_ID
#   OTP_PROVIDER          (= msg91 in prod)
#   SESSION_SECRET
#   DATABASE_URL
#
# India DLT (TRAI):
#   1. Register entity + OTP SMS template on DLT before flipping off mock
#   2. Create matching MSG91 OTP template (dashboard → OTP); copy template_id
#   3. Sender ID must match the DLT-approved header (6 chars typical)
#   4. Template variable for the code must accept the OTP we send (custom otp param)
#
# With OTP_PROVIDER=msg91, missing any of the three MSG91_* vars returns
# HTTP 503 code OTP_PROVIDER_MISCONFIGURED (no SMS call).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Production OTP (2Factor alternative) ---
# TWO_FACTOR_API_KEY=
# OTP_PROVIDER=2factor

# ---------------------------------------------------------------------------
# Soft-launch rate limits / spam guards (in-memory; per process)
# ---------------------------------------------------------------------------
RATE_LIMIT_OTP_PER_PHONE=3
RATE_LIMIT_OTP_WINDOW_SEC=60
RATE_LIMIT_OTP_PER_IP=20
RATE_LIMIT_SEARCH_PER_USER=30
RATE_LIMIT_BOOK_PER_USER=10
RATE_LIMIT_TRIP_POST_PER_USER=5
RATE_LIMIT_ACTION_WINDOW_SEC=60
MAX_TRIPS_PER_DRIVER_PER_DAY=8
MIN_DEPART_AHEAD_MINUTES=30
