# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://khalashi:khalashi@localhost:5432/khalashi

# ---------------------------------------------------------------------------
# Auth / OTP
# mock  = log OTP to console + return debugCode (local / soft-launch smoke)
# msg91 | 2factor = production SMS — only after India DLT template is approved
# ---------------------------------------------------------------------------
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
# Mock mode always accepts this code when set (optional convenience)
OTP_MOCK_CODE=123456

# JWT / session — replace with a long random secret in production
SESSION_SECRET=change-me-in-production
SESSION_TTL_SECONDS=604800

# --- Production OTP (MSG91) ---
# 1. Register entity + OTP template on DLT (TRAI) — this takes calendar time
# 2. Create MSG91 auth key + Flow/OTP template id matching DLT content
# 3. Set OTP_PROVIDER=msg91 and fill:
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Production OTP (2Factor alternative) ---
# TWO_FACTOR_API_KEY=
# OTP_PROVIDER=2factor

# ---------------------------------------------------------------------------
# Soft-launch rate limits / spam guards (in-memory; per process)
# ---------------------------------------------------------------------------
RATE_LIMIT_OTP_PER_PHONE=3
RATE_LIMIT_OTP_WINDOW_SEC=60
RATE_LIMIT_OTP_PER_IP=20
RATE_LIMIT_SEARCH_PER_USER=30
RATE_LIMIT_BOOK_PER_USER=10
RATE_LIMIT_TRIP_POST_PER_USER=5
RATE_LIMIT_ACTION_WINDOW_SEC=60
MAX_TRIPS_PER_DRIVER_PER_DAY=8
MIN_DEPART_AHEAD_MINUTES=30
